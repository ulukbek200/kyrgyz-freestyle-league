generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL" )
}

enum EventStatus {
  PLANNED
  LIVE
  COMPLETED
  CANCELLED
}
enum AgeDivision {
  U17
  U23
}
enum RegistrationStatus {
  ACTIVE
  INACTIVE
  NEEDS_REVIEW
}
enum Role {
  REGISTRAR
  ADMIN
  MODERATOR
  ATHLETE
}
enum AthleteStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  RETIRED
}
enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}
enum MatchMethod {
  DECISION
  TECHNICAL_FALL
  PIN
  FORFEIT
}
enum ApplicationStatus {
  PENDING
  REVIEW
  APPROVED
  REJECTED
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  isBlocked Boolean @default(false)
  sessionVersion Int @default(0)
  role Role @default(ATHLETE)
  athlete Athlete?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}
model Athlete {
  tournamentParticipants TournamentParticipant[]
  dateOfBirth DateTime? @db.Date
  registrations AthleteSeasonRegistration[]
  id String @id @default(cuid())
  firstName String
  lastName String
  nickname String?
  country String @default("Kyrgyzstan")
  nationality String @default("KG")
  city String
  imageUrl String?
  story String? @db.Text
  status AthleteStatus @default(ACTIVE)
  clubId String?
  coachId String?
  weightClassId String?
  userId String? @unique
  club Club? @relation(fields:[clubId], references:[id], onDelete:SetNull)
  coach Coach? @relation(fields:[coachId], references:[id], onDelete:SetNull)
  weightClass WeightClass? @relation(fields:[weightClassId], references:[id], onDelete:SetNull)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  matchesAsA Match[] @relation("AthleteA")
  matchesAsB Match[] @relation("AthleteB")
  wonMatches Match[] @relation("Winner")
  rankings Ranking[]
  snapshots RankingSnapshot[]
  championships Championship[]
  applications Application[]
  mediaPosts MediaPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([lastName, firstName])
  @@index([city, status])
}
model Club {
  id String @id @default(cuid())
  name String @unique
  city String
  country String @default("Kyrgyzstan")
  athletes Athlete[]
  coaches Coach[]
}
model Coach {
  id String @id @default(cuid())
  name String
  clubId String?
  club Club? @relation(fields:[clubId], references:[id], onDelete:SetNull)
  athletes Athlete[]
}
model WeightClass {
  tournamentParticipants TournamentParticipant[]
  eventWeights EventWeightClass[]
  ageDivision AgeDivision?
  registrations AthleteSeasonRegistration[]
  applications Application[]
  @@unique([ageDivision, kilograms])
  @@unique([id, ageDivision])
  id String @id @default(cuid())
  name String @unique
  kilograms Int
  order Int @default(0)
  athletes Athlete[]
  matches Match[]
  rankings Ranking[]
  snapshots RankingSnapshot[]
  championships Championship[]
}
// Single active season is enforced by the partial unique index in migration 202610120002.
model Season {
  cycle SeasonCycle?
  seasonYear Int?
  registrations AthleteSeasonRegistration[]
  applications Application[]
  id String @id @default(cuid())
  name String @unique
  description String? @db.Text
  startsAt DateTime
  endsAt DateTime?
  isActive Boolean @default(false)
  events Event[]
  matches Match[]
  rankings Ranking[]
  snapshots RankingSnapshot[]
  championships Championship[]
  createdAt DateTime @default(now())
}
model Event {
  formats TournamentFormat[]
  bannerUrl String?
  city String @default("")
  description String? @db.Text
  status EventStatus @default(PLANNED)
  participants TournamentParticipant[]
  weightClasses EventWeightClass[]
  ageDivision AgeDivision?
  id String @id @default(cuid())
  name String
  slug String @unique
  venue String
  startsAt DateTime
  seasonId String?
  season Season? @relation(fields:[seasonId], references:[id], onDelete:Restrict)
  matches Match[]
  createdAt DateTime @default(now())
  @@index([startsAt])
}
model Match {
  tournamentBout TournamentBout?
  ageDivision AgeDivision?
  id String @id @default(cuid())
  seasonId String?
  eventId String
  weightClassId String
  athleteAId String
  athleteBId String
  winnerId String?
  status MatchStatus @default(UPCOMING)
  scheduledAt DateTime
  isTitleFight Boolean @default(false)
  method MatchMethod?
  summary String? @db.Text
  season Season? @relation(fields:[seasonId], references:[id], onDelete:Restrict)
  event Event @relation(fields:[eventId], references:[id], onDelete:Restrict)
  weightClass WeightClass @relation(fields:[weightClassId], references:[id], onDelete:Restrict)
  athleteA Athlete @relation("AthleteA", fields:[athleteAId], references:[id], onDelete:Restrict)
  athleteB Athlete @relation("AthleteB", fields:[athleteBId], references:[id], onDelete:Restrict)
  winner Athlete? @relation("Winner", fields:[winnerId], references:[id], onDelete:SetNull)
  score MatchScore?
  rankings Ranking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([seasonId, weightClassId, status])
  @@index([scheduledAt])
}
model MatchScore {
  id String @id @default(cuid())
  matchId String @unique
  athleteAPoints Int @default(0)
  athleteBPoints Int @default(0)
  periodOneA Int @default(0)
  periodOneB Int @default(0)
  periodTwoA Int @default(0)
  periodTwoB Int @default(0)
  penaltiesA Int @default(0)
  penaltiesB Int @default(0)
  bonus Int @default(0)
  match Match @relation(fields:[matchId], references:[id], onDelete:Cascade)
}
model Ranking {
  id String @id @default(cuid())
  seasonId String?
  weightClassId String
  athleteId String
  rank Int
  points Int
  wins Int @default(0)
  losses Int @default(0)
  previousRank Int?
  season Season? @relation(fields:[seasonId], references:[id], onDelete:Cascade)
  weightClass WeightClass @relation(fields:[weightClassId], references:[id], onDelete:Cascade)
  athlete Athlete @relation(fields:[athleteId], references:[id], onDelete:Cascade)
  match Match? @relation(fields:[lastMatchId], references:[id], onDelete:SetNull)
  lastMatchId String?
  updatedAt DateTime @updatedAt
  @@unique([seasonId, weightClassId, athleteId])
  @@index([seasonId, weightClassId, rank])
}
model RankingSnapshot {
  id String @id @default(cuid())
  seasonId String?
  weightClassId String
  athleteId String
  eventId String?
  rank Int
  points Int
  recordedAt DateTime @default(now())
  season Season? @relation(fields:[seasonId], references:[id], onDelete:Cascade)
  weightClass WeightClass @relation(fields:[weightClassId], references:[id], onDelete:Cascade)
  athlete Athlete @relation(fields:[athleteId], references:[id], onDelete:Cascade)
  @@index([athleteId, recordedAt])
}
model Championship {
  id String @id @default(cuid())
  seasonId String?
  weightClassId String
  athleteId String
  matchId String? @unique
  isCurrent Boolean @default(true)
  wonAt DateTime
  defenses Int @default(0)
  season Season? @relation(fields:[seasonId], references:[id], onDelete:Restrict)
  weightClass WeightClass @relation(fields:[weightClassId], references:[id], onDelete:Restrict)
  athlete Athlete @relation(fields:[athleteId], references:[id], onDelete:Restrict)
  @@index([weightClassId, isCurrent])
}
model Application {
  seasonId String?
  weightClassId String?
  ageDivision AgeDivision?
  season Season? @relation(fields:[seasonId], references:[id], onDelete:Restrict)
  weightClass WeightClass? @relation(fields:[weightClassId], references:[id], onDelete:Restrict)
  id String @id @default(cuid())
  firstName String
  lastName String
  birthDate DateTime
  city String
  country String
  phone String
  email String
  weightKg Float
  clubName String?
  coachName String?
  experience String? @db.Text
  achievements String? @db.Text
  videoUrl String?
  photoUrl String?
  medicalInfo String? @db.Text
  status ApplicationStatus @default(PENDING)
  adminNotes String? @db.Text
  athleteId String?
  athlete Athlete? @relation(fields:[athleteId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}
model MediaPost {
  id String @id @default(cuid())
  title String
  slug String @unique
  category String
  excerpt String @db.Text
  imageUrl String?
  publishedAt DateTime?
  athleteId String?
  athlete Athlete? @relation(fields:[athleteId], references:[id], onDelete:SetNull)
}
model Sponsor {
  id String @id @default(cuid())
  name String
  logoUrl String?
  website String?
  isActive Boolean @default(true)
}
model Notification {
  id String @id @default(cuid())
  type String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
}
model RankingRule {
  id String @id @default(cuid())
  name String @unique @default("default")
  winPoints Int @default(3)
  earlyWinBonus Int @default(1)
  lossPoints Int @default(0)
  penaltyPoints Int @default(0)
  tieBreakRule String @default("WINS_THEN_FEWER_LOSSES")
  updatedAt DateTime @updatedAt
}




model AthleteSeasonRegistration {
  id String @id @default(cuid())
  athleteId String
  seasonId String
  ageDivision AgeDivision
  weightClassId String
  status RegistrationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  athlete Athlete @relation(fields:[athleteId], references:[id], onDelete:Restrict)
  season Season @relation(fields:[seasonId], references:[id], onDelete:Restrict)
  weightClass WeightClass @relation(fields:[weightClassId, ageDivision], references:[id, ageDivision], onDelete:Restrict)
  @@unique([athleteId, seasonId])
  @@index([seasonId, ageDivision, weightClassId], map: "AthleteSeasonRegistration_seasonId_ageDivision_weightClassId_id")
}

model EventWeightClass {
  formats TournamentFormat[]
  eventId String
  weightClassId String
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  weightClass WeightClass @relation(fields:[weightClassId], references:[id], onDelete:Restrict)
  @@id([eventId, weightClassId])
}
model TournamentParticipant {
  id String @id @default(cuid())
  eventId String
  athleteId String
  weightClassId String?
  ageDivision AgeDivision?
  status RegistrationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  event Event @relation(fields:[eventId], references:[id], onDelete:Restrict)
  athlete Athlete @relation(fields:[athleteId], references:[id], onDelete:Restrict)
  weightClass WeightClass? @relation(fields:[weightClassId], references:[id], onDelete:Restrict)
  @@unique([eventId, athleteId])
  @@index([eventId, weightClassId])
}

// Additive extension: legacy tables and global ranking semantics remain unchanged.
model SeasonCycle {
  seasonId String @id
  status String @default("PLANNED")
  summary String? @db.Text
  season Season @relation(fields:[seasonId], references:[id], onDelete:Restrict)
}

model TournamentFormat {
  id String @id @default(cuid())
  eventId String
  weightClassId String
  groups Json
  decisions Json @default("{}")
  confirmedHash String?
  createdAt DateTime @default(now())
  event Event @relation(fields:[eventId], references:[id], onDelete:Restrict)
  category EventWeightClass @relation(fields:[eventId,weightClassId], references:[eventId,weightClassId], onDelete:Restrict)
  bouts TournamentBout[]
  @@unique([eventId, weightClassId])
}

model TournamentBout {
  id String @id @default(cuid())
  formatId String
  phase String
  groupName String @default("")
  round Int
  position Int
  seedAId String?
  seedBId String?
  matchId String? @unique
  format TournamentFormat @relation(fields:[formatId], references:[id], onDelete:Restrict)
  match Match? @relation(fields:[matchId], references:[id], onDelete:Restrict)
  @@unique([formatId, phase, groupName, round, position])
}
