# Set your own PostgreSQL credentials; URL-encode special characters.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/nomad_league?schema=public"
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Empty for direct access. Behind a reverse proxy, list only its IPs/CIDRs.
# The proxy must overwrite X-Forwarded-For. Never set this to true or a hop count.
TRUSTED_PROXIES=""
# Development defaults to .local/uploads. Production requires an absolute path
# backed by a persistent disk (Render mount /var/data).
UPLOAD_DIR=""
# Bootstrap is explicit and first-admin-only; never commit filled values.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_DATABASE=""
BOOTSTRAP_CONFIRM=""

# Local Docker only; use a unique value and matching DATABASE_URL.
POSTGRES_PASSWORD=""
# Destructive demo seed is restricted to the dedicated local test DB.
SEED_ADMIN_PASSWORD=""
